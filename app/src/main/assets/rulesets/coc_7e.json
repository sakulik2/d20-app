            "target_value": "检定目标值",
            "san": "理智",
            "hp": "耐久"
        }
    },
    "mechanicsPipeline": {
        "entryNodeId": "roll_d100",
        "nodes": {
            "roll_d100": {
                "type": "roll",
                "diceFormula": "1d100",
                "outputVariable": "result",
                "nextNodeId": "select_fumble_threshold"
            },
            "select_fumble_threshold": {
                "type": "condition",
                "leftOperandSource": "intent:target_value",
                "operator": ">=",
                "rightOperandSource": "constant:50",
                "trueNodeId": "check_fumble_at_100",
                "falseNodeId": "check_fumble_at_96"
            },
            "check_fumble_at_100": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": ">=",
                "rightOperandSource": "constant:100",
                "trueNodeId": "set_fumble",
                "falseNodeId": "check_critical"
            },
            "check_fumble_at_96": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": ">=",
                "rightOperandSource": "constant:96",
                "trueNodeId": "set_fumble",
                "falseNodeId": "check_critical"
            },
            "set_fumble": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:CRITICAL_FAILURE",
                "nextNodeId": null
            },
            "check_critical": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": "<=",
                "rightOperandSource": "constant:1",
                "trueNodeId": "set_critical",
                "falseNodeId": "calc_extreme_target"
            },
            "set_critical": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:CRITICAL_SUCCESS",
                "nextNodeId": null
            },
            "calc_extreme_target": {
                "type": "math",
                "leftOperandSource": "intent:target_value",
                "operator": "/",
                "rightOperandSource": "constant:5",
                "outputVariable": "extreme_target",
                "nextNodeId": "check_extreme"
            },
            "check_extreme": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": "<=",
                "rightOperandSource": "variable:extreme_target",
                "trueNodeId": "set_extreme_success",
                "falseNodeId": "calc_hard_target"
            },
            "set_extreme_success": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:EXTREME_SUCCESS",
                "nextNodeId": null
            },
            "calc_hard_target": {
                "type": "math",
                "leftOperandSource": "intent:target_value",
                "operator": "/",
                "rightOperandSource": "constant:2",
                "outputVariable": "hard_target",
                "nextNodeId": "check_hard"
            },
            "check_hard": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": "<=",
                "rightOperandSource": "variable:hard_target",
                "trueNodeId": "set_hard_success",
                "falseNodeId": "check_regular"
            },
            "set_hard_success": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:HARD_SUCCESS",
                "nextNodeId": null
            },
            "check_regular": {
                "type": "condition",
                "leftOperandSource": "variable:result",
                "operator": "<=",
                "rightOperandSource": "intent:target_value",
                "trueNodeId": "set_regular_success",
                "falseNodeId": "set_failure"
            },
            "set_regular_success": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:REGULAR_SUCCESS",
                "nextNodeId": null
            },
            "set_failure": {
                "type": "effect",
                "targetType": "result_state",
                "targetKey": "state",
                "operation": "set",
                "valueSource": "constant:FAILURE",
                "nextNodeId": null
            }
        }
    }
