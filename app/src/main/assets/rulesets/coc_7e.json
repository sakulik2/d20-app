{
    "id": "coc_7e",
    "name": "克苏鲁的呼唤 7E",
    "description": "探索未知的恐怖，百分骰 (d100) 理智规则。",
    "version": "1.1.0",
    "checkRules": {
        "targetSource": "STAT_VALUE",
    "modifierSource": "EVENT",
    "equipmentBonusAppliesTo": "TARGET",
    "equipmentBonusActionIds": ["coc_check"],
        "defaultActionId": "coc_check",
        "requiredTargetActionIds": ["coc_check"],
        "allowedDiceExpressions": {
            "coc_check": ["1d100"]
        },
        "statAliases": {
            "str": ["力量", "strength"],
            "dex": ["敏捷", "dexterity"],
            "con": ["体质", "constitution"],
            "int": ["智力", "intelligence"],
            "pow": ["意志", "power"],
            "san": ["理智", "sanity"]
        },
        "targetLabel": "目标值"
    },
    "combatRules": {
